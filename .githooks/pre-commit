#!/bin/sh
# 提交前门禁。启用方式：
#   git config core.hooksPath .githooks
#
# 只做「快」的检查。耗时的测试留给 CI ——
# 本地钩子太慢会被 --no-verify 绕过，那就等于没有钩子。

set -e

echo "[pre-commit] moon check --deny-warn"
moon check --deny-warn

echo "[pre-commit] moon fmt 检查"
moon fmt
if ! git diff --quiet; then
  echo ""
  echo "[pre-commit] 有文件被 moon fmt 改动了，已自动格式化。"
  echo "             请 git add 后重新提交。"
  exit 1
fi

echo "[pre-commit] OK"
