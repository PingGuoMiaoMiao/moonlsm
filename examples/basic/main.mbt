///|
/// moonlsm 最小可跑示例：打开一个真实目录，写入、读回、范围扫描、删除。
///
/// 运行：
///   moon run examples/basic
///
/// 数据落在 ./example_data。**再运行一次**，第 1 步读到的还是上次写进去的
/// 那些 key —— 这是这个引擎和内存 dict 的唯一区别，也是示例要演的重点。
///
/// 想看归并发生：把下面的 memtable 阈值改成 64 KiB，循环写几万条，
/// 然后在程序运行期间看 ./example_data/sst/ 里的文件数变化。
fn main raise {
  let data_dir = "./example_data"

  // ---------------------------------------------------------------------
  // 1. 打开。参数二是 memtable 阈值（字节），写满自动 flush 成 L0 文件。
  //    open 会依次读 CURRENT -> MANIFEST -> 加载各层 SST -> 重放 WAL，
  //    所以这一步之后，上次进程写的东西已经全部可见。
  // ---------------------------------------------------------------------
  let db = @moonlsm.Db::open(
    @moonlsm.NativeStorage::new(data_dir),
    8 * 1024 * 1024,
  )
  println("已打开 " + data_dir)

  // ---------------------------------------------------------------------
  // 2. 写。**put 返回即代表 fsync 已经成功** —— 此刻断电，这条也在。
  //    这也是为什么 put 比 put_deferred 慢：它在等磁盘。
  // ---------------------------------------------------------------------
  let seq = db.put(b"user:1", b"alice")
  println("写入 user:1 -> alice，seq = " + seq.to_string())

  // ---------------------------------------------------------------------
  // 3. 读。key 不存在和 key 被删除都返回 None —— 对调用方是同一件事。
  // ---------------------------------------------------------------------
  match db.get(b"user:1") {
    Some(v) => println("读回 user:1 = " + @utf8.decode_lossy(v))
    None => println("user:1 不存在")
  }

  // ---------------------------------------------------------------------
  // 4. 批量写：一批只 fsync 一次。put_deferred 只把数据放进 WAL 缓冲，
  //    sync() 返回才代表整批落盘。
  //
  //    代价是失败可见性变差：写第一条时无法预知最后的 sync 会不会成功。
  //    要求「要么全可见、要么全不可见」时用 put，否则用这一对。
  // ---------------------------------------------------------------------
  for i in 2..<5 {
    let k = @utf8.encode("user:" + i.to_string())
    let v = @utf8.encode("user-" + i.to_string())
    db.put_deferred(k, v) |> ignore
  }
  db.sync()
  println("批量写入 user:2..4 并 sync 完成")

  // ---------------------------------------------------------------------
  // 5. 范围扫描，左闭右开 [start, end)。limit 是上限，不是精确条数。
  // ---------------------------------------------------------------------
  let rows = db.scan(b"user:", b"user;", 10)
  println(
    "扫描 [user:, user;) 得到 " + rows.length().to_string() + " 条：",
  )
  for p in rows {
    let k = @utf8.decode_lossy(p.key)
    let v = @utf8.decode_lossy(p.value)
    println("  " + k + " = " + v)
  }

  // ---------------------------------------------------------------------
  // 6. 删除不是抹掉，是写一条墓碑。墓碑只有在归并到最底层时才会被丢弃 ——
  //    在那之前它必须留着，否则更旧版本的数据会「复活」。
  // ---------------------------------------------------------------------
  db.delete(b"user:2") |> ignore
  let after = match db.get(b"user:2") {
    Some(_) => "仍能读到（这不对）"
    None => "返回 None"
  }
  println("删除 user:2 后 get " + after)

  // ---------------------------------------------------------------------
  // 7. 关闭。v1 不保持常开句柄，所以 close 只做一件事：标记状态 ——
  //    之后任何读写都抛 Closed，而不是静默继续用一个已关闭的库。
  //
  //    **它不刷 memtable，也不清 WAL。** 所以上面那句「数据仍然读得到」
  //    靠的不是 close，而是 WAL：不 close 直接退出进程也不丢已 ack 的写入
  //    （kill -9 测过 20 轮）。这也意味着 ./example_data/sst/ 现在很可能是
  //    空的，数据还在 wal/ 里 —— 下次 open 时重放出来。
  //    想看 SST 生成，就在中间调一次 db.flush()。
  // ---------------------------------------------------------------------
  db.close()
  println(
    "已关闭。重新运行这个示例，上面这些 key 仍然读得到。",
  )
}
